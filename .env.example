# Secret Key for Flask Session Signing (generate using: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=generate_a_random_32_byte_hex_string

# Single Admin Account Credentials
ADMIN_USERNAME=Batman
# Generate hash using: python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('your_password', method='scrypt'))"
ADMIN_PASSWORD_HASH=scrypt:32768:8:1$...

# Environment & Cookie Security
# In production, SESSION_COOKIE_SECURE must be True; it may remain False only for local HTTP development.
FLASK_ENV=production
SESSION_COOKIE_SECURE=True
